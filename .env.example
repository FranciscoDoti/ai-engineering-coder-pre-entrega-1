# Provider used by create_client() when none is given: openai or anthropic
LLM_PROVIDER=openai

# API keys: main.py runs against every provider whose key is set
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
